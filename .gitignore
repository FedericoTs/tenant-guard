# Scratch files from ad-hoc verification runs.
#
# Audit agents write throwaway probes into the repo ROOT, because that is where
# `import { PGlite } from '@electric-sql/pglite'` resolves from. They are
# supposed to delete them and mostly do; six were committed by a `git add -A`
# once, so the patterns are deliberately broad. Real source lives in src/, bin/
# and test/, none of which this touches.
probe-*.mjs
*scratch*.mjs
_scratch*
zz-*.mjs
zz_*.mjs
tmp-*.mjs
repro-*.mjs
*-repro*.mjs
verify-*.mjs
check-*.mjs
fix-*.py
patch-*.py
wire-*.py
add-*.py
close-*.py
cl*.py
build-*.py
extract.py
write-*.py

# Never commit a registry token. A project-level .npmrc holding an _authToken is
# the same class of mistake the mcp-config guard fails the build over, and it
# survives in git history long after the file is cleaned.
.npmrc
