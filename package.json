{
  "name": "tenant-guard",
  "version": "0.13.0",
  "description": "Guard tests that fail your CI when multi-tenant code can leak across tenants. Static guards run zero-dependency in CI; runtime guards prove one tenant can't read OR write another — reads, writes, tenant-hop, INSERT, views, materialized views, partitions, Supabase Storage paths, the anon surface, and whether the identity your policies trust can be forged. Checks that live in your repo and block the merge.",
  "type": "module",
  "license": "MIT",
  "author": "Federico Sciuca",
  "bin": {
    "tenant-guard": "bin/tenant-guard.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./guards/migration-collisions": "./src/guards/migration-collisions.mjs",
    "./guards/definer-grants": "./src/guards/definer-grants.mjs",
    "./guards/route-org-scoping": "./src/guards/route-org-scoping.mjs",
    "./guards/rls-proof": "./src/guards/rls-proof.mjs",
    "./guards/rls-drift": "./src/guards/rls-drift.mjs",
    "./guards/anon-writes": "./src/guards/anon-writes.mjs",
    "./guards/anon-reads": "./src/guards/anon-reads.mjs",
    "./guards/view-isolation": "./src/guards/view-isolation.mjs",
    "./guards/identity-trust": "./src/guards/identity-trust.mjs",
    "./guards/storage-isolation": "./src/guards/storage-isolation.mjs"
  },
  "files": [
    "bin",
    "src",
    "test",
    "examples",
    "README.md",
    "METHODOLOGY.md",
    "THREAT-MODEL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "selfcheck": "node bin/tenant-guard.mjs run",
    "prove": "node bin/tenant-guard.mjs prove",
    "demo:rls": "node examples/rls-proof/demo.mjs"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5"
  },
  "keywords": [
    "multi-tenant",
    "tenant-isolation",
    "rls",
    "row-level-security",
    "idor",
    "cross-tenant",
    "security",
    "ci",
    "guard",
    "guardrails",
    "supabase",
    "postgres",
    "nextjs",
    "saas",
    "ai-generated-code",
    "vibe-coding"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FedericoTs/tenant-guard.git"
  }
}
